# =============================================================================
# FutureMaker AI — Environment Configuration Example
# Copy this file to .env and fill in your values
# =============================================================================

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-side Supabase keys (prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Direct PostgreSQL Connection (Optional, falls back to Supabase API)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Google Gemini AI API Key (Required for Resume Review & Interview Roadmaps)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# JWT Session Secret (Any random 32+ character string)
JWT_SECRET=your-random-32-char-secret-key-here
VITE_APP_ID=futuremaker-ai

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development

# Google Maps (Optional) — server-side reverse geocoding for the user's city.
# The key must have the "Geocoding API" enabled in Google Cloud Console
# (APIs & Services → Library → Geocoding API). Without it, OpenStreetMap is used automatically.
GOOGLE_MAPS_API_KEY=

# Live local job postings (Optional, recommended) — JSearch on RapidAPI, which indexes
# LinkedIn, Indeed, Rozee.pk and Glassdoor postings via Google for Jobs.
# Subscribe (free tier available) at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# LinkedIn itself has no public job-search API, so this is how real LinkedIn listings appear.
JSEARCH_API_KEY=
# Second local job source (Optional) — SerpApi Google Jobs API. When both keys are set, both are
# searched at the same time and results are merged; if one is missing or out of quota, the other is used alone.
# Free plan: 250 searches/month, no card. Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# How long to reuse a job-search result for the same role + city (protects both free quotas).
JOB_SEARCH_CACHE_MINUTES=720
# Optional: stop calling a provider before its plan limit (defaults: JSearch 200, SerpApi 250).
# JSEARCH_MONTHLY_LIMIT=200
# SERPAPI_MONTHLY_LIMIT=250
